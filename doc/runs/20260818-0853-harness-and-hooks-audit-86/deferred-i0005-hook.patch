--- a/hooks/git/commit-msg
+++ b/hooks/git/commit-msg
@@ -5,15 +5,104 @@
 
 msg_file="$1"
 
-# Strip Co-authored-by: Cursor trailer (injected by Cursor IDE automatically)
-grep -v "Co-authored-by: Cursor" "$msg_file" \
-    | grep -v "cursoragent@cursor.com" \
