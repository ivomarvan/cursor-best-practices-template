+# Structure, not line-oriented grep: the trailer block is the last blank-line-separated
+# paragraph (or the whole message when it is only trailers). Prose before that block is
+# never touched — so an indented quote of an attribution string in the body stays.
+# Inside the trailer block, each trailer is a key line plus its indented continuation
+# lines; attribution trailers are dropped as a unit (folded forms included).
+#
+# Attribution: a -by/-with key whose unfolded value starts with "Cursor" (prefix —
+# CursorAgent, Cursory, Cursor Smith all go; that cost is intentional), or any trailer
+# whose lines carry cursoragent@cursor.com. Key grammar matches git interpret-trailers
+# (alnum/hyphen; optional spaces around ':'); '_' / '.' in keys still match the address
+# rule so the old unanchored address grep's removals stay removed.
+awk '
+function is_blank(s) { return s ~ /^[[:space:]]*$/ }
+function is_cont(s)  { return s ~ /^[ \t]+[^[:space:]]/ }
+function is_key(s)   { return s ~ /^[A-Za-z0-9-][A-Za-z0-9_.-]*[[:space:]]*:/ }
+
+function trim(s) {
+  gsub(/^[[:space:]]+/, "", s)
+  gsub(/[[:space:]]+$/, "", s)
+  return s
+}
+
+# Return 1 if lines[from..to] form an attribution trailer.
+function is_attribution(from, to,   first, colon, key, val, j, piece, lowkey, lowval) {
+  first = lines[from]
+  colon = index(first, ":")
+  if (colon == 0) return 0
+  key = trim(substr(first, 1, colon - 1))
+  val = trim(substr(first, colon + 1))
+  for (j = from + 1; j <= to; j++) {
+    piece = lines[j]
+    sub(/^[ \t]+/, "", piece)
+    if (val == "") val = piece
+    else val = val " " piece
+  }
+  for (j = from; j <= to; j++) {
+    if (tolower(lines[j]) ~ /cursoragent@cursor\.com/) return 1
+  }
+  lowkey = tolower(key)
+  lowval = tolower(val)
+  if (lowkey ~ /-(by|with)$/ && lowval ~ /^cursor/) return 1
+  return 0
+}
+
+{
+  sub(/\r$/, "")
+  lines[++n] = $0
+}
+
+END {
+  last_blank = 0
+  for (i = 1; i <= n; i++)
+    if (is_blank(lines[i])) last_blank = i
+
+  if (last_blank == 0) {
+    all_tr = 1
+    has_key = 0
+    for (i = 1; i <= n; i++) {
+      if (is_blank(lines[i])) continue
+      if (is_key(lines[i])) { has_key = 1; continue }
+      if (is_cont(lines[i])) continue
+      all_tr = 0
+      break
+    }
+    trailer_start = (all_tr && has_key) ? 1 : (n + 1)
+  } else {
+    trailer_start = last_blank + 1
+  }
+
+  for (i = 1; i < trailer_start; i++)
+    out[++o] = lines[i]
+
+  i = trailer_start
+  while (i <= n) {
+    if (is_blank(lines[i])) { i++; continue }
+    if (is_key(lines[i])) {
+      start = i
+      i++
+      while (i <= n && is_cont(lines[i])) i++
+      if (!is_attribution(start, i - 1)) {
+        for (j = start; j < i; j++) out[++o] = lines[j]
+      }
+      continue
+    }
+    # Orphan continuation or non-trailer line in the trailer zone: keep unless it
+    # alone still carries the agent address (residue of a half-stripped fold).
+    if (is_cont(lines[i]) && tolower(lines[i]) ~ /cursoragent@cursor\.com/) {
+      i++
+      continue
+    }
+    out[++o] = lines[i]
+    i++
+  }
+
+  while (o > 0 && is_blank(out[o])) o--
+  for (i = 1; i <= o; i++) print out[i]
+}
+' "$msg_file" > "$msg_file.tmp" || true
+mv "$msg_file.tmp" "$msg_file"
 
 exit 0
